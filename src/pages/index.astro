    .panel-key[data-panel-key='technologies'] .chip-core { transform-origin: 32px 32px; }
    .panel-key[data-panel-key='technologies']:hover .chip-core, .panel-key[data-panel-key='technologies']:focus-visible .chip-core, .panel-key[data-panel-key='technologies'][aria-pressed='true'] .chip-core { animation: chip-core .42s var(--ease-snap) both; }
    .panel-key[data-panel-key='technologies']:hover .chip-inner, .panel-key[data-panel-key='technologies']:focus-visible .chip-inner, .panel-key[data-panel-key='technologies'][aria-pressed='true'] .chip-inner { animation: chip-inner .42s var(--ease-snap) .22s both; }
    .panel-key[data-panel-key='technologies']:hover .chip-pin-t, .panel-key[data-panel-key='technologies']:focus-visible .chip-pin-t, .panel-key[data-panel-key='technologies'][aria-pressed='true'] .chip-pin-t { animation: chip-pin .3s var(--ease-reveal) .3s both; }
    .panel-key[data-panel-key='technologies']:hover .chip-pin-r, .panel-key[data-panel-key='technologies']:focus-visible .chip-pin-r, .panel-key[data-panel-key='technologies'][aria-pressed='true'] .chip-pin-r { animation: chip-pin .3s var(--ease-reveal) .4s both; }
    .panel-key[data-panel-key='technologies']:hover .chip-pin-b, .panel-key[data-panel-key='technologies']:focus-visible .chip-pin-b, .panel-key[data-panel-key='technologies'][aria-pressed='true'] .chip-pin-b { animation: chip-pin .3s var(--ease-reveal) .5s both; }
    .panel-key[data-panel-key='technologies']:hover .chip-pin-l, .panel-key[data-panel-key='technologies']:focus-visible .chip-pin-l, .panel-key[data-panel-key='technologies'][aria-pressed='true'] .chip-pin-l { animation: chip-pin .3s var(--ease-reveal) .6s both; }

    .panel-key:not(:hover):not(:focus-visible):not([aria-pressed='true']) .key-icon * { animation: none !important; transform: none !important; rotate: 0deg !important; }

    .live-cell { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 11px; color: var(--panel-ink); border-style: dashed; border-color: rgba(var(--ink-rgb),.4); background: transparent; }
    .live-ping { position: relative; display: grid; place-items: center; width: 34px; height: 34px; }
    .ping-core { width: 8px; height: 8px; border-radius: 50%; background: var(--screen-accent, var(--panel-rust)); box-shadow: 0 0 6px color-mix(in srgb, var(--screen-accent, var(--panel-rust)), transparent 45%); }
    .ping-ring { position: absolute; width: 8px; height: 8px; border: 1.4px solid var(--screen-accent, var(--panel-rust)); border-radius: 50%; opacity: 0; animation: ping 2.4s cubic-bezier(.2,.6,.3,1) infinite; }
    .ping-ring-2 { animation-delay: 1.2s; }
    @keyframes ping { 0% { transform: scale(1); opacity: .55; } 100% { transform: scale(3.6); opacity: 0; } }
    .live-label { font: 300 var(--text-micro)/1 var(--font-sans); letter-spacing: .1em; color: var(--muted); }

    .panel-cta { grid-column: span 2; padding: 0 20px; display: flex; align-items: center; justify-content: space-between; color: var(--panel-ink); text-decoration: none; font: 300 var(--text-micro)/1 var(--font-sans); letter-spacing: .08em; text-transform: uppercase; overflow: hidden; transition: color .16s ease, background-color .16s ease, box-shadow .16s ease; }
    .panel-cta span, .panel-cta b { position: relative; z-index: 1; }
