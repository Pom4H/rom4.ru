    @keyframes task-converge { 0% { transform: scale(1.55); opacity: 0 } 60% { opacity: 1 } 100% { transform: scale(1); opacity: 1 } } @keyframes task-lockdot { 0% { transform: scale(0) } 60% { transform: scale(1.35) } 100% { transform: scale(1) } } @keyframes task-tickdraw { 0% { opacity: 0; stroke-dashoffset: 10 } 100% { opacity: 1; stroke-dashoffset: 0 } }
