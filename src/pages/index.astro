    .panel-key[data-panel-key='task']:hover .target-dot, .panel-key[data-panel-key='task']:focus-visible .target-dot, .panel-key[data-panel-key='task'][aria-pressed='true'] .target-dot { animation: task-lockdot .42s var(--ease-snap) .34s both; }
    .panel-key[data-panel-key='task']:hover .target-tick, .panel-key[data-panel-key='task']:focus-visible .target-tick, .panel-key[data-panel-key='task'][aria-pressed='true'] .target-tick { animation: task-tickdraw .3s var(--ease-reveal) .3s both; }

    @keyframes prototype-open-a { from { transform: translate(8px,8px); } to { transform: translate(0,0); } } @keyframes prototype-open-b { from { transform: translate(-8px,-8px); } to { transform: translate(0,0); } } @keyframes prototype-grow { 0% { transform: scale(.12); opacity: .2; } 70% { opacity: 1; } 100% { transform: scale(1); opacity: 1; } }
    .panel-key[data-panel-key='prototype']:hover .expand-a, .panel-key[data-panel-key='prototype']:focus-visible .expand-a, .panel-key[data-panel-key='prototype'][aria-pressed='true'] .expand-a { animation: prototype-open-a .5s var(--ease-snap) both; }
    .panel-key[data-panel-key='prototype']:hover .expand-b, .panel-key[data-panel-key='prototype']:focus-visible .expand-b, .panel-key[data-panel-key='prototype'][aria-pressed='true'] .expand-b { animation: prototype-open-b .5s var(--ease-snap) both; }
