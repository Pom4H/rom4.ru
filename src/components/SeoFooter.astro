---
const links = [
  ['Роман Попов', '/roman-popov/'],
  ['ПО для оборудования', '/software-dlya-oborudovaniya/'],
  ['Мониторинг оборудования', '/monitoring-oborudovaniya/'],
  ['Мобильные приложения для устройств', '/mobilnye-prilozheniya-dlya-oborudovaniya/'],
  ['AI для инженерных компаний', '/ai-dlya-inzhenernyh-kompaniy/'],
  ['Внутренние инженерные системы', '/vnutrennie-inzhenernye-sistemy/'],
];
---

<nav class="seo-nav" aria-label="Основные направления ROM4.RU">
  <div class="seo-nav__inner">
    <p class="seo-nav__label">НАПРАВЛЕНИЯ</p>
    <div class="seo-nav__links">
      {links.map(([label, href]) => <a href={href}>{label}</a>)}
    </div>
  </div>
</nav>

<style>
  .seo-nav {
    width: min(1440px, calc(100% - 44px));
    margin: 0 auto 25px;
    color: var(--ink, #141915);
    background: var(--paper, #f0efe8);
    border: 1px solid rgba(var(--ink-rgb, 20, 25, 21), .28);
    border-top: 0;
  }

  .seo-nav__inner {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 28px;
    padding: 24px 32px 28px;
  }

  .seo-nav__label {
    margin: 4px 0 0;
    color: var(--muted, #62645e);
    font: 700 10px/1.4 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    letter-spacing: .08em;
  }

  .seo-nav__links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
  }

  .seo-nav a {
    color: inherit;
    font-size: 13px;
    line-height: 1.45;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  .seo-nav a:hover { color: var(--rust, #bd5b31); }

  @media (max-width: 700px) {
    .seo-nav { width: calc(100% - 20px); }
    .seo-nav__inner { grid-template-columns: 1fr; gap: 12px; padding: 22px 20px 24px; }
    .seo-nav__links { display: grid; gap: 12px; }
  }
</style>
