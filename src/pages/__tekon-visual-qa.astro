---
export const prerender = true;

const preview = 'https://tekon-git-agent-final-typography-pass-pom4hs-projects.vercel.app';
const routes = [
  '/',
  '/564-fz/',
  '/certificates/',
  '/company/',
  '/contacts/',
  '/documentation/',
  '/news/',
  '/products/',
  '/software/',
  '/404.html',
  '/products/kio-2ms/',
  '/products/kun-ip8/',
  '/products/kcs-ipm/',
  '/products/ksl-rs/',
  '/products/kup-4rs/',
  '/products/kir-16/',
  '/products/kun-2dm/',
  '/products/upsl-m/'
] as const;

const devices = [
  { id: 'desktop', width: 1440, height: 1000, isMobile: false, hasTouch: false },
  { id: 'mobile', width: 430, height: 932, isMobile: true, hasTouch: true }
] as const;

type Shot = {
  route: string;
  device: string;
  width: number;
  height: number;
  url: string | null;
  error: string | null;
};

const extractUrl = (value: unknown): string | null => {
  if (typeof value === 'string') {
    const match = value.match(/https?:\/\/[^\s"'<>]+/);
    return match?.[0] ?? null;
  }
  if (Array.isArray(value)) {
    for (const item of value) {
      const found = extractUrl(item);
      if (found) return found;
    }
  }
  if (value && typeof value === 'object') {
    const record = value as Record<string, unknown>;
    for (const key of ['content', 'pageshot', 'screenshot', 'image', 'url', 'data']) {
      if (key in record) {
        const found = extractUrl(record[key]);
        if (found) return found;
      }
    }
    for (const item of Object.values(record)) {
      const found = extractUrl(item);
      if (found) return found;
    }
  }
  return null;
};

const capture = async (route: string, device: typeof devices[number]): Promise<Shot> => {
  const target = new URL(route, `${preview}/`).href;
  try {
    const response = await fetch('https://r.jina.ai/', {
      method: 'POST',
      headers: {
        accept: 'application/json',
        'content-type': 'application/json',
        'x-respond-with': 'pageshot',
        'x-no-cache': 'true',
        'x-remove-overlay': 'true',
        'x-timeout': '45'
      },
      body: JSON.stringify({
        url: target,
        viewport: {
          width: device.width,
          height: device.height,
          deviceScaleFactor: 1,
          isMobile: device.isMobile,
          hasTouch: device.hasTouch
        }
      })
    });
    const text = await response.text();
    if (!response.ok) throw new Error(`Reader ${response.status}: ${text.slice(0, 180)}`);
    let payload: unknown = text;
    try { payload = JSON.parse(text); } catch {}
    const url = extractUrl(payload);
    if (!url) throw new Error(`Screenshot URL not found: ${text.slice(0, 180)}`);
    return { route, device: device.id, width: device.width, height: device.height, url, error: null };
  } catch (error) {
    return {
      route,
      device: device.id,
      width: device.width,
      height: device.height,
      url: null,
      error: error instanceof Error ? error.message : String(error)
    };
  }
};

const jobs = routes.flatMap(route => devices.map(device => ({ route, device })));
const shots: Shot[] = [];
for (let index = 0; index < jobs.length; index += 4) {
  const batch = jobs.slice(index, index + 4);
  shots.push(...await Promise.all(batch.map(({ route, device }) => capture(route, device))));
}
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>ТЕКОН — временный visual QA</title>
    <style>
      :root { color-scheme: dark; font-family: system-ui, sans-serif; background: #111; color: #eee; }
      body { margin: 0; padding: 24px; }
      h1 { margin: 0 0 8px; }
      p { color: #aaa; }
      .grid { display: grid; gap: 24px; }
      article { padding: 18px; border: 1px solid #333; border-radius: 18px; background: #191919; }
      h2 { margin: 0 0 14px; font-size: 18px; }
      .shots { display: grid; grid-template-columns: minmax(0, 2fr) minmax(260px, .7fr); gap: 16px; align-items: start; }
      figure { margin: 0; min-width: 0; }
      img { display: block; width: 100%; height: auto; background: white; border-radius: 10px; }
      figcaption { margin-top: 8px; color: #aaa; font-size: 12px; }
      a { color: #bcff45; }
      pre { white-space: pre-wrap; color: #ff9b9b; }
      @media (max-width: 800px) { body { padding: 12px; } .shots { grid-template-columns: 1fr; } }
    </style>
  </head>
  <body>
    <h1>ТЕКОН — визуальный QA</h1>
    <p>Временная noindex-галерея. Каждый кадр получен из актуальной preview-ветки.</p>
    <main class="grid">
      {routes.map(route => (
        <article>
          <h2>{route}</h2>
          <div class="shots">
            {devices.map(device => {
              const shot = shots.find(item => item.route === route && item.device === device.id)!;
              return (
                <figure>
                  {shot.url ? (
                    <a href={shot.url}><img src={shot.url} alt={`${route} — ${device.id}`} loading="lazy" /></a>
                  ) : (
                    <pre>{shot.error}</pre>
                  )}
                  <figcaption>{device.id} · {device.width}×{device.height}{shot.url && <> · <a href={shot.url}>исходный PNG</a></>}</figcaption>
                </figure>
              );
            })}
          </div>
        </article>
      ))}
    </main>
  </body>
</html>
