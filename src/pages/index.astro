      .panel-key, .reset-key, .panel-cta, .live-cell { border-radius: 9px; }
      .panel-key { padding: 5px 3px 4px; }
      .panel-screen { padding: 12px 12px; border-radius: 10px; }
      .panel-screen .readout-title { font-size: clamp(14px, 4.2vw, 18px); }
      .panel-screen .readout-detail { font-size: var(--text-sm); }
      .key-number { left: 4px; top: 4px; font-size: 8px; }
      .key-led { right: 4px; top: 4px; }
      .key-label { font-size: 7px; letter-spacing: 0; }
      .panel-cta { padding-inline: 10px; font-size: 8px; }
      .side-label { font-size: 7px; letter-spacing: .08em; }
      .side-label-left { left: 12px; }
      .side-label-right { right: 12px; }
      .screw { width: 7px; height: 7px; } .screw-a { left: 13px; top: 13px; } .screw-b { right: 13px; top: 13px; } .screw-c { right: 13px; bottom: 13px; } .screw-d { left: 13px; bottom: 13px; }
    }
    :root[data-theme='dark'] .panel-key:hover, :root[data-theme='dark'] .panel-key:focus-visible, :root[data-theme='dark'] .panel-key[aria-pressed='true'] { color: color-mix(in srgb, var(--key-accent), white 42%); }
    :root[data-theme='dark'] .panel-key[aria-pressed='true'] { background: color-mix(in srgb, var(--key-accent) 16%, var(--panel-paper)); box-shadow: 0 0 0 1px color-mix(in srgb, var(--key-accent), white 30%), 0 0 20px color-mix(in srgb, var(--key-accent), transparent 66%); }
    :root[data-theme='dark'] .panel-key:hover, :root[data-theme='dark'] .panel-key:focus-visible { box-shadow: 0 0 0 1px color-mix(in srgb, var(--key-accent), white 20%); }
    :root[data-theme='dark'] .ping-core { background: color-mix(in srgb, var(--screen-accent), white 34%); box-shadow: 0 0 6px color-mix(in srgb, var(--screen-accent), transparent 40%); }
    :root[data-theme='dark'] .ping-ring { border-color: color-mix(in srgb, var(--screen-accent), white 34%); }
</style>

<script is:inline>
  (function () {
    function init() {
      const root = document.documentElement;
      root.classList.add('js');
      const meta = document.querySelector('meta[name="theme-color"]');

      try {
        const stored = localStorage.getItem('theme');
        const theme = (stored === 'light' || stored === 'dark') ? stored
          : (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        root.setAttribute('data-theme', theme);
        if (meta) meta.setAttribute('content', theme === 'dark' ? '#0f1518' : '#f0efe8');
      } catch (e) { root.setAttribute('data-theme', 'light'); }

      let animTimer = 0;
      const toggles = document.querySelectorAll('[data-theme-toggle]');
      const syncToggles = (t) => toggles.forEach((b) => {
        b.setAttribute('aria-pressed', t === 'dark' ? 'true' : 'false');
        b.setAttribute('aria-label', t === 'dark' ? 'Включить светлую тему' : 'Включить тёмную тему');
      });
      const setTheme = (t, persist) => {
        root.classList.add('theme-anim');
        root.setAttribute('data-theme', t);
        if (meta) meta.setAttribute('content', t === 'dark' ? '#0f1518' : '#f0efe8');
        if (persist) { try { localStorage.setItem('theme', t); } catch (e) {} }
        syncToggles(t);
        clearTimeout(animTimer);
        animTimer = setTimeout(() => root.classList.remove('theme-anim'), 240);
      };
      syncToggles(root.getAttribute('data-theme') === 'dark' ? 'dark' : 'light');
      toggles.forEach((btn) => btn.addEventListener('click', () => {
        setTheme(root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark', true);
      }));
      try {
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
          if (!localStorage.getItem('theme')) setTheme(e.matches ? 'dark' : 'light', false);
        });
      } catch (e) {}

      /* Прототип в телефоне: каталог → карточка → корзина. Никаких
         фреймворков — три экрана и немного состояния, ровно столько, чтобы
         по нему можно было пройти как по настоящему приложению. */
      (function phoneApp() {
        /* Мониторинг цеха: линия → машина → заявки. Значения живые, поэтому
           это не макет, а работающая вещь: показания идут, состояние машины
           переключается, заявки закрываются. Всё на чистом DOM. */
        const root = document.querySelector('[data-phone]');
        if (!root) return;

        const MACHINES = {
          1: { name: 'Пресс П-4', batch: 3184, oee: 92, rate: 146, scrap: 1.4, temp: 184, run: true },
          2: { name: 'Экструдер Э-2', batch: 3185, oee: 78, rate: 118, scrap: 2.1, temp: 203, run: true },
          3: { name: 'Упаковка У-1', batch: 3181, oee: 64, rate: 92, scrap: 4.6, temp: 41, run: false },
        };
        let alerts = [
          { id: 1, m: 'Упаковка У-1', text: 'Стоп по датчику плёнки', level: 'высокий' },
          { id: 2, m: 'Экструдер Э-2', text: 'Температура выше уставки', level: 'средний' },
        ];
        let current = 1;
        const plot = [];

        const views = root.querySelectorAll('[data-view]');
        const tabs = root.querySelectorAll('[data-tab]');
        const badge = root.querySelector('[data-badge]');
        const el = (sel) => root.querySelector(sel);

        const show = (name) => {
          views.forEach((v) => (v.dataset.view === name ? v.setAttribute('data-on', '') : v.removeAttribute('data-on')));
          tabs.forEach((t) => (t.dataset.tab === (name === 'item' ? 'list' : name)
            ? t.setAttribute('data-on', '') : t.removeAttribute('data-on')));
        };

        const paintList = () => {
          Object.entries(MACHINES).forEach(([id, m]) => {
            const dot = root.querySelector(`[data-dot="${id}"]`);
            dot.dataset.state = m.run ? (m.oee < 70 ? 'warn' : 'ok') : 'stop';
            root.querySelector(`[data-oee="${id}"]`).textContent = String(Math.round(m.oee));
            root.querySelector(`[data-batch="${id}"]`).textContent = m.run ? `партия ${m.batch}` : 'остановлена';
          });
          el('[data-shift]').textContent = `${Object.values(MACHINES).filter((m) => m.run).length}/3 в работе`;
        };

        const paintItem = () => {
          const m = MACHINES[current];
          el('[data-name]').textContent = m.name;
          const pill = el('[data-pill]');
          pill.textContent = m.run ? 'работает' : 'остановлен';
          pill.dataset.pillState = m.run ? 'ok' : 'stop';
          el('[data-rate]').textContent = m.run ? String(Math.round(m.rate)) : '0';
          el('[data-scrap]').textContent = m.scrap.toFixed(1);
          el('[data-temp]').textContent = String(Math.round(m.temp));
          el('[data-toggle]').textContent = m.run ? 'Остановить' : 'Запустить';
          el('[data-toggle]').toggleAttribute('data-done', !m.run);
          el('[data-plot]').setAttribute(
            'points',
            plot.map((v, i) => `${(i / (plot.length - 1 || 1)) * 120},${40 - (v / 200) * 34}`).join(' '),
          );
        };

        const paintAlerts = () => {
          const box = el('[data-alerts]');
          box.innerHTML = alerts
            .map((a) => `<div class="app-alert" data-level="${a.level}">
              <span class="app-alert-text"><b>${a.m}</b><i>${a.text}</i></span>
              <button class="app-take" type="button" data-take="${a.id}">Взять</button>
            </div>`)
            .join('');
          el('[data-alerts-empty]').hidden = alerts.length > 0;
          badge.textContent = String(alerts.length);
          badge.hidden = alerts.length === 0;
          box.querySelectorAll('[data-take]').forEach((b) =>
            b.addEventListener('click', () => {
              alerts = alerts.filter((a) => a.id !== +b.dataset.take);
              paintAlerts();
            }));
        };

        root.querySelectorAll('[data-open]').forEach((b) =>
          b.addEventListener('click', () => { current = +b.dataset.open; paintItem(); show('item'); }));
        el('[data-back]').addEventListener('click', () => show('list'));
        tabs.forEach((t) => t.addEventListener('click', () => show(t.dataset.tab)));
        el('[data-toggle]').addEventListener('click', () => {
          const m = MACHINES[current];
          m.run = !m.run;
          if (!m.run) {
            alerts = alerts.concat([{ id: Date.now(), m: m.name, text: 'Остановлена оператором', level: 'средний' }]);
            paintAlerts();
          }
          paintItem();
          paintList();
        });

        /* Показания идут сами: без этого прототип снова стал бы картинкой. */
        const tick = () => {
          Object.values(MACHINES).forEach((m) => {
            if (!m.run) { m.oee = Math.max(0, m.oee - 1.5); return; }
            m.rate += (Math.random() - 0.5) * 9;
            m.rate = Math.min(190, Math.max(70, m.rate));
            m.scrap = Math.min(9, Math.max(0.2, m.scrap + (Math.random() - 0.5) * 0.3));
            m.temp += (Math.random() - 0.5) * 3;
            m.oee = Math.min(99, Math.max(40, m.oee + (Math.random() - 0.48) * 2));
          });
          const cur = MACHINES[current];
          plot.push(cur.run ? cur.rate : 0);
          if (plot.length > 26) plot.shift();
          paintList();
          paintItem();
        };
        for (let i = 0; i < 26; i++) plot.push(120 + Math.sin(i / 3) * 26);
        paintList(); paintItem(); paintAlerts();
        let timer = setInterval(tick, 1600);
        document.addEventListener('visibilitychange', () => {
          clearInterval(timer);
          if (!document.hidden) timer = setInterval(tick, 1600);
        });

        const clock = el('[data-app-time]');
        const clockTick = () => {
          const n = new Date();
          clock.textContent = n.getHours() + ':' + String(n.getMinutes()).padStart(2, '0');
        };
        clockTick();
        setInterval(clockTick, 30000);
      })();

      /* Секции показываются сразу. Появление по мере скролла держалось на
         IntersectionObserver, а лист теперь лежит в fixed-слое и ездит
         трансформом — наблюдатель там срабатывает ненадёжно, и часть секций
         так и оставалась невидимой. */
      const revealSelector = '.system-visual,.section-intro,.direction-card,.result-card,.proof-graphic,.mode,.stack-col,.method-manifesto,.method-track article,.footer-primary,.footer-aside';
      document.querySelectorAll(revealSelector).forEach((el) => el.classList.add('is-in'));

      document.querySelectorAll('[data-system-panel]').forEach((panel) => {
        const keys = Array.from(panel.querySelectorAll('[data-panel-key]'));
        const rIndex = panel.querySelector('[data-readout-index]');
        const rLabel = panel.querySelector('[data-readout-label]');
        const rTitle = panel.querySelector('[data-readout-title]');
        const rDetail = panel.querySelector('[data-readout-detail]');
        const screen = panel.querySelector('[data-panel-readout]');
        const showReadout = (key) => {
          panel.dataset.active = key.dataset.panelKey;
          if (key.dataset.accent) panel.style.setProperty('--screen-accent', key.dataset.accent);
          if (rIndex) rIndex.textContent = key.dataset.index || '';
          if (rLabel) rLabel.textContent = key.dataset.label || '';
          if (rTitle) rTitle.textContent = key.dataset.title || '';
          if (rDetail) rDetail.textContent = key.dataset.detail || '';
          if (screen) { screen.classList.remove('is-switching'); void screen.offsetWidth; screen.classList.add('is-switching'); }
        };
        const playIcon = (key) => {
          const els = key.querySelectorAll('.key-icon *');
          els.forEach((el) => { el.style.animation = 'none'; });
          void key.offsetWidth;
          els.forEach((el) => { el.style.animation = ''; });
        };
        let userPicked = false;
        keys.forEach((key) => key.addEventListener('click', () => {
          userPicked = true;
          const on = key.getAttribute('aria-pressed') === 'true';
          if (on) {
            key.setAttribute('aria-pressed', 'false');
          } else {
            key.setAttribute('aria-pressed', 'true');
            showReadout(key);
            playIcon(key);
          }
        }));
        const first = keys[0];
        if (first) showReadout(first);
        const boot = () => {
          if (userPicked) return;
          first.setAttribute('aria-pressed', 'true');
          showReadout(first);
          playIcon(first);
        };
        /* Панель поднимается сразу, а не по появлению в кадре: наблюдатель
           в наклонённом fixed-слое ненадёжен, и клавиша оставалась неактивной. */
        if (first) setTimeout(boot, 450);
      });

    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
