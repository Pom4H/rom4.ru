---
/**
 * Канцелярия на столе.
 *
 * Предметы лежат в той же наклонённой плоскости, что и лист, и едут при
 * прокрутке с той же скоростью: газета тонкая, разницы в фокусном расстоянии
 * между ней и столешницей нет. Полосы прокрутки у листа нет — где мы
 * находимся, показывают проплывающие мимо линейка, карандаши, скрепки.
 *
 * Слой строго декоративный: `aria-hidden`, `pointer-events: none`, и он
 * появляется только вместе с CSS-наклоном (`html[data-paper-tilt='on']`).
 * В canvas-режиме HexFloat и на телефоне его нет.
 *
 * Раскладка: у каждого предмета `--x`/`--y` — координаты его ЦЕНТРА в
 * процентах от экрана, `--w` — ширина, `--r` — поворот. Центрирование делает
 * позицию независимой от размера и угла. `--y` больше 100% — предмет ждёт
 * своей очереди ниже кромки и выплывает при прокрутке.
 */

/**
 * Предметы вдоль стола сверху вниз, стороны чередуются.
 *
 * Поле стола в плоскости листа постоянной ширины, но на экране оно сужается
 * к ближнему краю: у нижней кромки перспектива уводит его за границу кадра.
 * Отсюда небольшой отступ — при нём предмет остаётся в поле и у дальнего
 * края, и у ближнего.
 */
const LEFT = '-5%';
const RIGHT = '105%';

/** Скрепка сидит на кромке листа, поэтому её место — ровно край, а не поле. */
const EDGE_L = '0%';
const EDGE_R = '100%';

/**
 * Скрепки отличаются ДЛИНОЙ, а не толщиной: проволока у всех одного калибра.
 * Поэтому ширина у них общая, а `len` удлиняет прямые участки — дуги сверху
 * и снизу остаются прежнего радиуса, как у настоящей скрепки.
 */
const CLIP_W = '2.6%';
/** Наружная петля — она видна всегда. */
const clipOuter = (len = 0) =>
  `M12 ${58 + len} L12 20 a9 9 0 0 1 18 0 L30 ${52 + len} a5 5 0 0 1 -10 0`;
/** Внутренняя проволока. Именно она уходит ЗА лист у надетой скрепки. */
const clipTongue = (len = 0) => `M20 ${52 + len} L20 26`;
const clipBox = (len = 0) => `7 7 28 ${56 + len}`;

const props = [
  { id: 'clip', x: EDGE_L, y: '7%', w: CLIP_W, r: '90deg', tone: 'rust', len: 30 },
  /* Ручка отодвинута вниз: на 16% она попадала прямо под лампу. */
  { id: 'pen', x: RIGHT, y: '44%', w: '12%', r: '84deg' },
  { id: 'ruler', x: '-4.2%', y: '34%', w: '2.8%', r: '-2deg' },
  { id: 'eraser', x: RIGHT, y: '58%', w: '4.4%', r: '-11deg' },
  { id: 'clip', x: EDGE_R, y: '66%', w: CLIP_W, r: '-90deg', tone: 'blue', len: 0 },
  { id: 'pencil', x: LEFT, y: '78%', w: '13%', r: '86deg' },
  { id: 'marker', x: RIGHT, y: '100%', w: '10.5%', r: '-84deg' },
  { id: 'sticky', x: LEFT, y: '122%', w: '4.6%', r: '-7deg' },
  { id: 'binder', x: RIGHT, y: '144%', w: '3.4%', r: '11deg' },
  { id: 'clip', x: EDGE_L, y: '158%', w: CLIP_W, r: '90deg', len: 62 },
  { id: 'clip', x: EDGE_R, y: '176%', w: CLIP_W, r: '-90deg', tone: 'pos', len: 14 },
  { id: 'stub', x: LEFT, y: '166%', w: '6.4%', r: '96deg' },
  { id: 'pen', x: LEFT, y: '210%', w: '12%', r: '92deg' },
  { id: 'sticky', x: RIGHT, y: '232%', w: '4.6%', r: '9deg' },
  { id: 'clip', x: EDGE_R, y: '244%', w: CLIP_W, r: '-90deg', tone: 'brass', len: 46 },
  { id: 'clip', x: EDGE_L, y: '268%', w: CLIP_W, r: '90deg', tone: 'rust', len: 8 },
  { id: 'eraser', x: LEFT, y: '256%', w: '4.4%', r: '14deg' },
  { id: 'marker', x: RIGHT, y: '278%', w: '10.5%', r: '88deg' },
  { id: 'ruler', x: '-3.5%', y: '300%', w: '2.4%', r: '3deg' },
  { id: 'binder', x: RIGHT, y: '322%', w: '3.4%', r: '-14deg' },
];

/**
 * Высота предмета над столом в условных единицах — от неё считается тень.
 * Стикер лежит плашмя, биндер стоит на сантиметр: одинаковая тень на всех
 * и делала их похожими на наклейки.
 */
const lift: Record<string, number> = {
  sticky: 2,
  clip: 2,
  ruler: 3,
  stub: 5,
  pencil: 6,
  pen: 6,
  eraser: 7,
  marker: 7,
  binder: 11,
};

/** viewBox каждой фигуры — нужен и символу, и внешнему svg (задаёт пропорции). */
const box: Record<string, string> = {
  pen: '0 0 300 26',
  ruler: '0 0 44 420',
  eraser: '0 0 130 56',
  pencil: '0 0 320 30',
  marker: '0 0 250 42',
  sticky: '0 0 120 118',
  binder: '0 0 104 78',
  stub: '0 0 150 28',
};
---

<svg class="desk-sprite" aria-hidden="true" width="0" height="0">
  <defs>
    <!-- Ручка с клипсой -->
    <symbol id="dp-pen" viewBox={box.pen}>
      <path d="M2 13 L22 6 L22 20 Z" class="pen-tip" />
      <path d="M22 6 L46 4 L46 22 L22 20 Z" class="pen-cone" />
      <rect x="46" y="4" width="196" height="18" rx="2" class="pen-body" />
      <rect x="242" y="3" width="54" height="20" rx="3" class="pen-cap" />
      <path d="M252 3 L252 -3 L286 -3 L286 3" class="pen-clip" />
      <line x1="46" y1="9" x2="242" y2="9" class="pen-gloss" />
    </symbol>

    <!-- Масштабная линейка -->
    <symbol id="dp-ruler" viewBox={box.ruler}>
      <rect x="1" y="1" width="42" height="418" rx="3" class="ruler-body" />
      <line x1="12" y1="1" x2="12" y2="419" class="ruler-edge" />
      {Array.from({ length: 41 }, (_, i) => {
        const y = 8 + i * 10;
        return <line x1="12" y1={y} x2={i % 5 === 0 ? 30 : 22} y2={y} class="ruler-tick" />;
      })}
      <text x="34" y="60" class="ruler-label">10</text>
      <text x="34" y="160" class="ruler-label">20</text>
      <text x="34" y="260" class="ruler-label">30</text>
      <text x="34" y="360" class="ruler-label">40</text>
    </symbol>

    <!-- Ластик -->
    <symbol id="dp-eraser" viewBox={box.eraser}>
      <rect x="1.5" y="1.5" width="127" height="53" rx="4" class="eraser-body" />
      <rect x="40" y="1.5" width="48" height="53" class="eraser-band" />
    </symbol>

    <!-- Карандаш: заточка, шестигранный корпус, обойма с ластиком -->
    <symbol id="dp-pencil" viewBox={box.pencil}>
      <path d="M4 15 L28 4 L28 26 Z" class="pencil-lead" />
      <path d="M28 4 L58 4 L58 26 L28 26 Z" class="pencil-wood" />
      <rect x="58" y="4" width="212" height="22" rx="1.5" class="pencil-body" />
      <line x1="58" y1="11" x2="270" y2="11" class="pencil-facet" />
      <line x1="58" y1="19" x2="270" y2="19" class="pencil-facet" />
      <rect x="270" y="4" width="26" height="22" class="pencil-ferrule" />
      <line x1="277" y1="4" x2="277" y2="26" class="pencil-facet" />
      <line x1="288" y1="4" x2="288" y2="26" class="pencil-facet" />
      <rect x="296" y="5.5" width="20" height="19" rx="8" class="pencil-eraser" />
    </symbol>

    <!-- Маркер со скошенным наконечником -->
    <symbol id="dp-marker" viewBox={box.marker}>
      <path d="M2 16 L26 10 L30 30 L6 32 Z" class="marker-nib" />
      <path d="M26 8 L54 6 L54 36 L28 32 Z" class="marker-collar" />
      <rect x="54" y="5" width="132" height="32" rx="4" class="marker-body" />
      <rect x="186" y="3" width="60" height="36" rx="5" class="marker-cap" />
      <line x1="66" y1="14" x2="174" y2="14" class="marker-band" />
    </symbol>

    <!-- Стикер с загнутым уголком -->
    <symbol id="dp-sticky" viewBox={box.sticky}>
      <path d="M2 2 H118 V96 L96 116 H2 Z" class="sticky-body" />
      <path d="M118 96 H96 V116 Z" class="sticky-fold" />
      <line x1="18" y1="34" x2="98" y2="34" class="sticky-rule" />
      <line x1="18" y1="52" x2="98" y2="52" class="sticky-rule" />
      <line x1="18" y1="70" x2="74" y2="70" class="sticky-rule" />
    </symbol>

    <!-- Биндер -->
    <symbol id="dp-binder" viewBox={box.binder}>
      <path d="M20 30 L52 6 L84 30" class="binder-handle" />
      <path d="M34 34 L60 12" class="binder-handle" />
      <path d="M8 34 H96 L84 74 H20 Z" class="binder-body" />
      <line x1="8" y1="34" x2="96" y2="34" class="binder-lip" />
    </symbol>

    <!-- Огрызок карандаша -->
    <symbol id="dp-stub" viewBox={box.stub}>
      <path d="M3 14 L26 4 L26 24 Z" class="pencil-lead" />
      <path d="M26 4 L52 4 L52 24 L26 24 Z" class="pencil-wood" />
      <rect x="52" y="4" width="95" height="20" rx="1.5" class="stub-body" />
      <line x1="52" y1="10.5" x2="147" y2="10.5" class="pencil-facet" />
      <line x1="52" y1="17.5" x2="147" y2="17.5" class="pencil-facet" />
    </symbol>
  </defs>
</svg>

<div class="desk-props" aria-hidden="true">
  {props.map((p) => (
    <div
      class="prop-cast"
      data-prop={p.id}
      data-pinned={p.id === 'clip' ? 'on' : undefined}
      data-edge={p.id === 'clip' ? (p.x === EDGE_L ? 'l' : 'r') : undefined}
      style={`--x:${p.x};--y:${p.y};--w:${p.w};--lift:${lift[p.id]}`}
    >
      <svg
        class={`prop prop-${p.id}${p.tone ? ` tone-${p.tone}` : ''}`}
        viewBox={p.id === 'clip' ? clipBox(p.len) : box[p.id]}
        fill="none"
        style={`--r:${p.r}`}
      >
        {p.id === 'clip' ? (
          <Fragment>
            <path d={clipOuter(p.len)} class="clip-wire" />
            {/* pathLength нормирует длину к 100 — по нему и режется половина */}
            <path d={clipTongue(p.len)} class="clip-wire clip-tongue" pathLength="100" />
          </Fragment>
        ) : (
          <use href={`#dp-${p.id}`} />
        )}
      </svg>
    </div>
  ))}
</div>

<style is:global>
  .desk-sprite { position: absolute; width: 0; height: 0; overflow: hidden; }
  .desk-props { display: none; }

  @media (min-width: 1024px) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    html[data-paper-tilt='on'] .desk-props {
      display: block;
      position: absolute;
      inset: 0;
      z-index: 1;
      pointer-events: none;
      /* Та же плоскость, что и лист, и тот же сдвиг (`--desk-shift` считает
         HexFloat.astro) — предметы едут вместе с газетой, а не отстают. */
      transform:
        rotateX(var(--tilt-angle))
        scale(var(--tilt-scale))
        translateY(calc(var(--desk-shift, 0px) * -1));
      transform-origin: 50% 50%;

      --prop-body: color-mix(in srgb, var(--paper) 82%, var(--ink));
      --prop-body-hi: color-mix(in srgb, var(--paper) 94%, var(--ink));
      --prop-line: rgba(var(--ink-rgb), .45);
      --prop-ink: rgba(var(--ink-rgb), .68);
      --prop-steel: color-mix(in srgb, var(--paper) 62%, var(--ink));
      --prop-shadow: rgba(25, 25, 23, .34);
    }

    :root[data-theme='dark'] .desk-props {
      --prop-body: color-mix(in srgb, var(--paper) 62%, var(--ink) 18%);
      --prop-body-hi: color-mix(in srgb, var(--paper) 78%, var(--ink) 10%);
      --prop-line: rgba(var(--ink-rgb), .34);
      --prop-ink: rgba(var(--ink-rgb), .5);
      --prop-steel: color-mix(in srgb, var(--paper) 52%, var(--ink) 26%);
      --prop-shadow: rgba(0, 0, 0, .6);
    }
  }

  /* Тень и поворот РАЗВЕДЕНЫ по двум элементам намеренно. `filter` считается
     в локальных координатах, а `transform` применяется уже к результату:
     на одном элементе тень поворачивалась вместе с предметом, и у всего, что
     лежит поперёк (ручка, карандаш, маркер — поворот около 90°), она уезжала
     вбок вместо низа. Теперь обёртка позиционирует и отбрасывает тень,
     а поворачивается только сама фигура внутри.

     Свет в сцене идёт от лампы справа сверху, поэтому тень уходит влево-вниз.
     Смещение и размытие считаются от `--lift` — высоты предмета над столом. */
  .desk-props .prop-cast {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--w);
    transform: translate(-50%, -50%);
    filter: drop-shadow(
      calc(var(--lift, 4) * -.45px)
      calc(var(--lift, 4) * 1.5px)
      calc(var(--lift, 4) * .9px)
      var(--prop-shadow)
    );
  }

  .desk-props .prop {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    transform: rotate(var(--r, 0deg));
    /* Мышь ловит сама фигура, а не обёртка: у обёртки прямоугольник
       неповёрнутый, и у лежащих поперёк предметов он накрыл бы половину поля.
       У повёрнутого svg область попадания идёт вместе с рисунком. */
    pointer-events: auto;
    cursor: grab;
    touch-action: none;
  }

  /* Курсор подсказывает, что сделает хват: у пишущих предметов кончик пишет,
     хвост вращает, середина переносит. Зону проставляет скрипт при наведении. */
  .desk-props .prop-cast[data-zone='tip'] .prop { cursor: crosshair; }
  .desk-props .prop-cast[data-zone='tail'] .prop { cursor: alias; }
  .desk-props .prop-cast.is-held .prop { cursor: grabbing; }

  /* Предмет в руке приподнимается над столом — тень длиннее и мягче. */
  .desk-props .prop-cast.is-held {
    filter: drop-shadow(
      calc(var(--lift, 4) * -.9px)
      calc(var(--lift, 4) * 3px)
      calc(var(--lift, 4) * 1.7px)
      var(--prop-shadow)
    );
  }

  /* ── Чернила ─────────────────────────────────────────────────────────
     Слой лежит внутри самого листа, поэтому штрихи едут вместе с бумагой и
     хранятся прямо в её координатах. Выше зерна (z-index 6), но ниже
     приводочных крестов. */
  .desk-ink {
    position: absolute;
    inset: 0;
    z-index: 7;
    width: 100%;
    height: 100%;
    overflow: hidden;
    pointer-events: none;
  }

  .ink {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ink-pencil { stroke: color-mix(in srgb, var(--ink) 78%, var(--paper)); stroke-width: 2.4; opacity: .85; }
  .ink-stub { stroke: color-mix(in srgb, var(--ink) 88%, var(--paper)); stroke-width: 3; opacity: .8; }
  .ink-pen { stroke: var(--blue); stroke-width: 2.2; }
  .ink-marker { stroke: var(--rust); stroke-width: 13; opacity: .28; }

  /* ── Материалы ───────────────────────────────────────────────────────── */
  .ruler-body { fill: color-mix(in srgb, var(--prop-body-hi) 80%, transparent); stroke: var(--prop-line); stroke-width: 1.2; }
  .ruler-edge { stroke: var(--prop-line); stroke-width: 1; }
  .ruler-tick { stroke: var(--prop-ink); stroke-width: 1.1; }
  .ruler-label { font-family: var(--font-mono); font-size: 13px; fill: var(--prop-line); }

  .pencil-lead { fill: var(--ink); }
  .pencil-wood { fill: var(--prop-body-hi); stroke: var(--prop-line); stroke-width: 1; }
  .pencil-body { fill: var(--rust); }
  .stub-body { fill: var(--blue); }
  .pencil-facet { stroke: rgba(0, 0, 0, .16); stroke-width: 1; }
  .pencil-ferrule { fill: var(--prop-steel); }
  .pencil-eraser { fill: color-mix(in srgb, var(--paper) 70%, var(--rust)); }

  .pen-tip, .pen-cone { fill: var(--prop-steel); }
  .pen-body, .pen-cap { fill: var(--blue); }
  .pen-clip { stroke: var(--prop-steel); stroke-width: 2.6; fill: none; }
  .pen-gloss { stroke: rgba(255, 255, 255, .22); stroke-width: 2; }

  .marker-nib { fill: var(--prop-steel); }
  .marker-collar { fill: var(--prop-body); }
  .marker-body { fill: var(--prop-body); stroke: var(--prop-line); stroke-width: 1; }
  .marker-cap { fill: var(--pos); }
  .marker-band { stroke: var(--prop-line); stroke-width: 1.2; }

  /* Скрепки бывают разные — от стальных до цветных канцелярских.
     Толщина проволоки не задаётся отдельно: она масштабируется вместе
     с фигурой, поэтому крупная скрепка сама выходит толще. */
  .clip-wire { stroke: var(--clip-ink, var(--prop-steel)); stroke-width: 3.4; stroke-linecap: round; fill: none; }
  /* Надетая скрепка охватывает кромку: наружная петля остаётся сверху листа,
     а внутренняя проволока ныряет ПОД него — и на бумажной стороне её не
     видно. Прячем ровно половину этой проволоки штриховкой по длине пути
     (`pathLength="100"` нормирует его к сотне). Какая половина — зависит от
     кромки, сторону проставляет скрипт.

     Маской по всей фигуре это делать нельзя: тогда на бумажной стороне
     пропадает и наружная петля, и скрепка выглядит просто обрезанной. */
  /* Грубая заготовка до запуска скрипта: ровно половина. Точную точку
     пересечения с кромкой считает JS и переписывает инлайном. */
  .prop-cast[data-edge] .clip-tongue { stroke-dasharray: 50 100; }
  .prop-cast[data-edge='r'] .clip-tongue { stroke-dashoffset: -50; }

  .prop-clip.tone-rust { --clip-ink: var(--rust); }
  .prop-clip.tone-blue { --clip-ink: var(--blue-2); }
  .prop-clip.tone-pos { --clip-ink: var(--pos); }
  .prop-clip.tone-brass { --clip-ink: color-mix(in srgb, #d8b24a 72%, var(--rust)); }

  .eraser-body { fill: var(--prop-body-hi); stroke: var(--prop-line); stroke-width: 1.2; }
  .eraser-band { fill: color-mix(in srgb, var(--blue) 34%, var(--paper)); }

  .sticky-body { fill: color-mix(in srgb, var(--paper) 62%, white); stroke: var(--prop-line); stroke-width: 1.2; }
  .sticky-fold { fill: color-mix(in srgb, var(--paper) 74%, var(--ink)); }
  .sticky-rule { stroke: var(--prop-line); stroke-width: 1.6; }

  .binder-body { fill: color-mix(in srgb, var(--ink) 88%, var(--paper)); }
  .binder-lip { stroke: var(--prop-steel); stroke-width: 2.4; }
  .binder-handle { stroke: var(--prop-steel); stroke-width: 3; fill: none; stroke-linecap: round; }

  /* Шейдер рисует свой мир — канцелярия туда не относится. */
  html[data-hexfloat='on'] .desk-props { display: none; }
</style>

<script>
  import { initDeskTools } from '../lib/deskTools';

  /* Только там, где есть стол: канцелярия и наклон включаются одним и тем же
     медиазапросом, поэтому спрашиваем у него, а не у ширины экрана. */
  const desk = matchMedia(
    '(min-width: 1024px) and (pointer: fine) and (prefers-reduced-motion: no-preference)',
  );

  let started = false;

  function boot() {
    if (started) return;
    if (!desk.matches) return;
    // Атрибут ставит скрипт HexFloat, а порядок модулей не гарантирован —
    // поэтому не только спрашиваем, но и ждём появления.
    if (document.documentElement.dataset.paperTilt !== 'on') return;
    started = true;
    watch.disconnect();
    desk.removeEventListener('change', boot);
    initDeskTools();
  }

  const watch = new MutationObserver(boot);
  watch.observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['data-paper-tilt'],
  });
  desk.addEventListener('change', boot);
  boot();
</script>
