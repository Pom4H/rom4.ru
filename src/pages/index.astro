    .panel-key[data-panel-key='infrastructure']:hover .infra-led-2, .panel-key[data-panel-key='infrastructure']:focus-visible .infra-led-2, .panel-key[data-panel-key='infrastructure'][aria-pressed='true'] .infra-led-2 { animation: infra-led .4s var(--ease-reveal) .46s both; }
    .panel-key[data-panel-key='infrastructure']:hover .infra-led-3, .panel-key[data-panel-key='infrastructure']:focus-visible .infra-led-3, .panel-key[data-panel-key='infrastructure'][aria-pressed='true'] .infra-led-3 { animation: infra-led .4s var(--ease-reveal) .58s both; }

    @keyframes cli-frame-draw { 0% { stroke-dashoffset: 160 } 100% { stroke-dashoffset: 0 } } @keyframes cli-prompt-draw { 0% { opacity: 0; stroke-dashoffset: 20 } 40% { opacity: 1 } 100% { opacity: 1; stroke-dashoffset: 0 } } @keyframes cli-blink { 0% { opacity: 0 } 30% { opacity: 1 } 60% { opacity: 1 } 75% { opacity: 0 } 100% { opacity: 1 } }
