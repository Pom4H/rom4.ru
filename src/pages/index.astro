    .panel-key[data-panel-key='infrastructure']:hover .infra-unit-2, .panel-key[data-panel-key='infrastructure']:focus-visible .infra-unit-2, .panel-key[data-panel-key='infrastructure'][aria-pressed='true'] .infra-unit-2 { animation: infra-stack .38s var(--ease-snap) .1s both; }
