    .panel-key[data-panel-key='product']:hover .cube-left, .panel-key[data-panel-key='product']:focus-visible .cube-left, .panel-key[data-panel-key='product'][aria-pressed='true'] .cube-left { animation: product-slide-left .66s var(--ease-snap) .06s both; }
    .panel-key[data-panel-key='product']:hover .cube-right, .panel-key[data-panel-key='product']:focus-visible .cube-right, .panel-key[data-panel-key='product'][aria-pressed='true'] .cube-right { animation: product-slide-right .66s var(--ease-snap) .06s both; }
    .panel-key[data-panel-key='product']:hover .cube-seam, .panel-key[data-panel-key='product']:focus-visible .cube-seam, .panel-key[data-panel-key='product'][aria-pressed='true'] .cube-seam { animation: product-seam .7s var(--ease-reveal) both; }
