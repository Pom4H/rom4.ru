---
import '@fontsource-variable/inter';
import HexFloat from '../components/HexFloat.astro';
import PaperTable from '../components/PaperTable.astro';
import DeskProps from '../components/DeskProps.astro';
import DeskLamp from '../components/DeskLamp.astro';
import { repositionHome } from '../lib/homePositioning';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const isHome = Astro.url.pathname === '/';
const effectiveDescription = isHome
  ? 'Digital, software и AI для растущих компаний. Нахожу, что стоит улучшить или построить, проверяю рабочим прототипом и довожу до запуска.'
  : description;
const homeHtml = isHome ? repositionHome(await Astro.slots.render('default')) : '';

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://rom4.ru/#website',
      url: 'https://rom4.ru/',
      name: 'ROM4.RU',
      description: effectiveDescription,
      inLanguage: 'ru-RU',
    },
    {
      '@type': 'Person',
      '@id': 'https://rom4.ru/#roman-popov',
      name: 'Роман Попов',
      alternateName: ['ROM4.RU', 'Pom4H'],
      url: 'https://rom4.ru/',
      jobTitle: 'Digital Product Partner, Software Engineer, AI and Fractional CTO',
      description: effectiveDescription,
      sameAs: ['https://t.me/Pom4H', 'https://github.com/Pom4H'],
    },
  ],
};
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {effectiveDescription && <meta name="description" content={effectiveDescription} />}
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#f0efe8" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="ROM4.RU" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    {effectiveDescription && <meta property="og:description" content={effectiveDescription} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ROM4.RU — Продукт уровня вашего бренда" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {effectiveDescription && <meta name="twitter:description" content={effectiveDescription} />}
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <!-- Theme init (no-flash): set data-theme before first paint -->
    <script is:inline>
      (function () {
        try {
          var q = (location.search.match(/[?&]theme=(light|dark)/) || [])[1];
          var stored = localStorage.getItem('theme');
          var theme = q
            || (stored === 'light' || stored === 'dark' ? stored : null)
            || (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', theme);
          document.documentElement.classList.add('js');
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', theme === 'dark' ? '#0f1518' : '#f0efe8');
        } catch (e) {}
      })();
    </script>
    <!-- Yandex.Metrika counter -->
    <script is:inline>
      (function(m,e,t,r,i,k,a){
          m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
          m[i].l=1*new Date();
          for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
          k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)
      })(window, document,'script','https://mc.yandex.ru/metrika/tag.js?id=110382417', 'ym');

      ym(110382417, 'init', {ssr:true, webvisor:true, clickmap:true, ecommerce:"dataLayer", referrer: document.referrer, url: location.href, accurateTrackBounce:true, trackLinks:true});
    </script>
    <!-- /Yandex.Metrika counter -->
  </head>
  <body>
    <noscript>
      <div><img src="https://mc.yandex.ru/watch/110382417" style="position:absolute; left:-9999px;" alt="" /></div>
    </noscript>

    <PaperTable />

    <HexFloat>
      {isHome ? <Fragment set:html={homeHtml} /> : <slot />}
      <DeskProps slot="desk" />
      <DeskLamp slot="desk" />
    </HexFloat>
  </body>
</html>

<style is:global>
  .engagement-body { padding: 30px 36px; display: grid; }
  .engagement-track { display: grid; grid-template-columns: repeat(3, 1fr); border: 1px solid rgba(var(--ink-rgb),.38); }
  .engagement-card { position: relative; min-height: 330px; padding: 34px clamp(26px, 3vw, 42px) 30px; display: flex; flex-direction: column; }
  .engagement-card + .engagement-card { border-left: 1px solid rgba(var(--ink-rgb),.22); }
  .engagement-card-accent { background: rgba(var(--ink-rgb),.035); }
  .engagement-index { font: 700 var(--text-micro)/1 var(--font-mono); letter-spacing: .08em; color: var(--muted); }
  .engagement-card h3 { margin: 28px 0 0; font: 400 clamp(25px, 2vw, 31px)/1.08 var(--font-serif); letter-spacing: -.02em; }
  .engagement-card p { margin: 20px 0 0; max-width: 29em; font-size: var(--text-list); line-height: 1.58; color: rgba(var(--ink-rgb),.76); text-wrap: pretty; }
  .engagement-card b { margin-top: auto; padding-top: 28px; font: 700 var(--text-micro)/1 var(--font-mono); letter-spacing: .1em; color: var(--pen); }
  @media (max-width: 800px) {
    .engagement-body { padding: 24px; }
    .engagement-track { grid-template-columns: 1fr; }
    .engagement-card { min-height: 0; padding: 30px 25px; }
    .engagement-card + .engagement-card { border-left: 0; border-top: 1px solid rgba(var(--ink-rgb),.22); }
    .engagement-card b { margin-top: 26px; padding-top: 0; }
  }
  @media (max-width: 520px) { .engagement-body { padding: 12px; } }
</style>
