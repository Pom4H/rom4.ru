---
import '@fontsource-variable/inter';
import SeoFooter from '../components/SeoFooter.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  pageType?: 'WebPage' | 'ProfilePage' | 'CollectionPage';
  noindex?: boolean;
  schema?: Record<string, unknown>;
}

const {
  title,
  description,
  image = '/og.png',
  imageAlt = 'ROM4.RU — software-продукты для оборудования и инженерного бизнеса',
  pageType = 'WebPage',
  noindex = false,
  schema,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const isHome = canonical.pathname === '/';
const metaTitle = isHome
  ? 'Роман Попов — разработка ПО для оборудования | ROM4.RU'
  : `${title} | ROM4.RU`;
const metaDescription = isHome
  ? 'Роман Попов разрабатывает ПО для оборудования и инженерных компаний: web, mobile, IoT, backend, мониторинг, внутренние системы и AI.'
  : description;
const ogImage = new URL(image, Astro.site);
const websiteId = 'https://rom4.ru/#website';
const personId = 'https://rom4.ru/#roman-popov';
const businessId = 'https://rom4.ru/#business';
const pageId = `${canonical.href}#webpage`;

const graph: Record<string, unknown>[] = [
  {
    '@type': 'WebSite',
    '@id': websiteId,
    url: 'https://rom4.ru/',
    name: 'ROM4.RU',
    description: 'Software-продукты вокруг оборудования, инженерных данных и технических процессов.',
    inLanguage: 'ru-RU',
    publisher: { '@id': personId },
  },
  {
    '@type': 'Person',
    '@id': personId,
    name: 'Роман Попов',
    alternateName: ['ROM4.RU', 'Pom4H'],
    url: 'https://rom4.ru/roman-popov/',
    email: 'mailto:1@rom4.ru',
    jobTitle: 'AI-native software engineer',
    description: 'Разрабатывает software-продукты для оборудования, инженерных компаний и технических команд: web, mobile, IoT, backend, инфраструктура и AI.',
    sameAs: ['https://github.com/Pom4H', 'https://t.me/Pom4H'],
    knowsAbout: [
      'software for industrial equipment',
      'industrial IoT',
      'mobile applications for connected devices',
      'equipment monitoring',
      'backend systems',
      'engineering software',
      'AI agents for technical workflows',
    ],
    worksFor: { '@id': businessId },
  },
  {
    '@type': 'ProfessionalService',
    '@id': businessId,
    name: 'ROM4.RU',
    url: 'https://rom4.ru/',
    founder: { '@id': personId },
    email: '1@rom4.ru',
    areaServed: 'Worldwide',
    serviceType: [
      'Разработка ПО для оборудования',
      'Мониторинг и диспетчеризация оборудования',
      'Мобильные приложения для устройств',
      'Внутренние инженерные системы',
      'AI-инструменты для инженерных компаний',
    ],
  },
  {
    '@type': pageType,
    '@id': pageId,
    url: canonical.href,
    name: metaTitle,
    description: metaDescription,
    isPartOf: { '@id': websiteId },
    about: [{ '@id': personId }, { '@id': businessId }],
    inLanguage: 'ru-RU',
    primaryImageOfPage: { '@type': 'ImageObject', url: ogImage.href },
  },
];

if (schema) graph.push(schema);

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': graph,
};
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{metaTitle}</title>
    {metaDescription && <meta name="description" content={metaDescription} />}
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#f0efe8" />
    <meta property="og:type" content={pageType === 'ProfilePage' ? 'profile' : 'website'} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="ROM4.RU" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={metaTitle} />
    {metaDescription && <meta property="og:description" content={metaDescription} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={metaTitle} />
    {metaDescription && <meta name="twitter:description" content={metaDescription} />}
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <!-- Theme init (no-flash): set data-theme before first paint -->
    <script is:inline>
      (function () {
        try {
          var q = (location.search.match(/[?&]theme=(light|dark)/) || [])[1];
          var stored = localStorage.getItem('theme');
          var theme = q
            || (stored === 'light' || stored === 'dark' ? stored : null)
            || (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', theme);
          document.documentElement.classList.add('js');
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', theme === 'dark' ? '#0f1518' : '#f0efe8');
        } catch (e) {}
      })();
    </script>
    <!-- Yandex.Metrika counter -->
    <script is:inline>
      (function(m,e,t,r,i,k,a){
          m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
          m[i].l=1*new Date();
          for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
          k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)
      })(window, document,'script','https://mc.yandex.ru/metrika/tag.js?id=110382417', 'ym');

      ym(110382417, 'init', {ssr:true, webvisor:true, clickmap:true, ecommerce:"dataLayer", referrer: document.referrer, url: location.href, accurateTrackBounce:true, trackLinks:true});
    </script>
    <!-- /Yandex.Metrika counter -->
  </head>
  <body>
    <noscript>
      <div><img src="https://mc.yandex.ru/watch/110382417" style="position:absolute; left:-9999px;" alt="" /></div>
    </noscript>

    <slot />
    <SeoFooter />
  </body>
</html>
