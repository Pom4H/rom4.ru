---
/**
 * Paper Table — «газета на столе» средствами CSS.
 *
 * Работает во всех браузерах и не зависит от HexFloat: даёт поверхность стола
 * под листом, контактную тень, подложенный второй лист и бумажное зерно.
 * Когда HexFloat всё-таки поднялся (`html[data-hexfloat='on']`), слой
 * выключается целиком — там наклон, швы и зерно рисует шейдер.
 *
 * Столешница живёт в собственном фиксированном слое `.desk-surface`, а не в
 * фоне `body`: фон документа при прокрутке уезжает вместе со страницей, а
 * `background-attachment: fixed` заставляет браузер перерисовывать текстуру
 * на каждом кадре. Фиксированный элемент растеризуется один раз — стол стоит
 * на месте и на мыши, и на тач-устройствах, и без затрат на прокрутку.
 *
 * Селекторы намеренно утяжелены (`html body`, `:root .paper-stage`): стили
 * страницы тоже глобальные, и порядок их подключения зависит от сборки —
 * специфичность делает результат независимым от порядка.
 */
---

<div class="desk-surface" aria-hidden="true"></div>

<style is:global>
  :root {
    /* Столешница — белый пластик (ламинат): холоднее и ровнее тёплой бумаги.
       Материал читается не цветом, а тремя вещами: широкой диагональной
       полосой блеска, матовой микрокрошкой и очень слабой неровностью. */
    --desk-tooth-alpha: .11;
    /* Лак: узкий жёсткий блик, широкая мягкая засветка за ним и лёгкое
       затемнение с противоположной стороны — без контраста глянец не читается. */
    --gloss-hard: rgba(255, 255, 255, .34);
    --gloss-soft: rgba(255, 255, 255, .1);
    --gloss-dark: rgba(18, 24, 30, .08);
    /* Френель: у дальней кромки луч зрения идёт по касательной, и отражает
       она сильнее ближней. Матовая поверхность так не умеет. */
    --gloss-fresnel: rgba(255, 255, 255, .22);
    /* Отражение лампы. Глянец показывает не свет, а сам источник. */
    --gloss-lamp: rgba(255, 240, 210, .5);
    --grid-fine: rgba(64, 104, 126, .03);
    --grid-bold: rgba(64, 104, 126, .075);
    --grid-fine-step: 31px;
    --grid-bold-step: 124px;
    /* Стол — тёплый капучино: бумага на нём остаётся светлее и холоднее,
       поэтому лист читается листом без единого дополнительного слоя. */
    --table-base: #c6b096;
    --table-sheen: rgba(255, 255, 255, .26);
    /* Свет тёплый (лампа), тень холодная (общий свет комнаты). Разница
       цветовых температур и делает поверхность материалом, а не заливкой. */
    --table-light: rgba(255, 246, 226, .34);
    --table-shade: rgba(22, 32, 42, .34);
    --table-contact: rgba(25, 25, 23, .34);
    /* Сгиб листа: на светлой бумаге ловит блик, на тёмной — почти только тень. */
    --fold-far: rgba(var(--ink-rgb), .016);
    --fold-near: rgba(var(--ink-rgb), .026);
    --fold-hi: rgba(var(--hi-rgb), .14);
    --fold-tail: rgba(var(--ink-rgb), .012);
  }

  :root[data-theme='dark'] {
    /* Тот же пластик, только графитовый: блеск слабее, крошка заметнее. */
    --desk-tooth-alpha: .17;
    --gloss-hard: rgba(214, 236, 255, .12);
    --gloss-soft: rgba(198, 222, 240, .03);
    --gloss-dark: rgba(0, 0, 0, .3);
    --gloss-fresnel: rgba(190, 220, 245, .07);
    --gloss-lamp: rgba(255, 216, 154, .14);
    --grid-fine: rgba(126, 170, 200, .07);
    --grid-bold: rgba(126, 170, 200, .14);
    --table-base: #0d100f;
    --table-sheen: rgba(150, 178, 190, .1);
    --table-light: rgba(126, 162, 176, .09);
    --table-shade: rgba(0, 0, 0, .55);
    --table-contact: rgba(0, 0, 0, .6);
    --fold-far: rgba(0, 0, 0, .16);
    --fold-near: rgba(0, 0, 0, .3);
    --fold-hi: rgba(var(--hi-rgb), .035);
    --fold-tail: rgba(0, 0, 0, .12);
  }

  /* ── Столешница: белый пластик ───────────────────────────────────────
     Сверху вниз по слоям: диагональная полоса блеска (главный признак
     пластика), рассеянный свет от источника, спад в тень к ближнему краю,
     матовая крошка и еле заметная неровность материала. Направленного
     волокна нет намеренно — оно читалось бы как дерево.

     Источник света — настольная лампа справа сверху, поэтому и блеск, и
     рассеянный свет приходят оттуда же, а тени предметов уходят влево-вниз. */
  :root {
    --table-layers:
      /* Отражение лампы — вытянутое к зрителю пятно под самим прибором. */
      radial-gradient(34% 58% at 88% 4%, var(--gloss-lamp), transparent 64%),
      /* Френель по глубине: дальний край ярче ближнего. */
      linear-gradient(to bottom, var(--gloss-fresnel) 0%, transparent 44%),
      /* Блик несимметричный: резкий фронт и длинный хвост. У матовой
         поверхности он симметричный и размытый — в этом вся разница. */
      linear-gradient(
        253deg,
        var(--gloss-dark) 0%,
        transparent 17%,
        var(--gloss-soft) 26.5%,
        var(--gloss-hard) 28.5%,
        var(--gloss-hard) 29.5%,
        var(--gloss-soft) 34%,
        transparent 60%
      ),
      radial-gradient(120% 78% at 84% -12%, var(--table-light), transparent 56%),
      radial-gradient(150% 105% at 50% 116%, var(--table-shade), transparent 62%);
    --table-layer-repeat: no-repeat, no-repeat, no-repeat, no-repeat, no-repeat;
    --table-layer-size: auto, auto, auto, auto, auto;
  }

  html { background-color: var(--table-base); }
  html body { background-color: var(--table-base); }

  /* Свет сцены неподвижен — лампа стоит на столе, а не едет с бумагой.
     Поэтому блеск, рассеянный свет и спад в тень живут в фиксированном слое
     и не перерисовываются при прокрутке. */
  .desk-surface {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-color: var(--table-base);
    background-image: var(--table-layers);
    background-repeat: var(--table-layer-repeat);
    background-size: var(--table-layer-size);
    /* Свой композитный слой: иначе неподвижная столешница перерисовывается
       вместе с едущим листом, и каждый градиент лака стоит кадров. */
    transform: translateZ(0);
  }


  /* ── Лист на столе ───────────────────────────────────────────────────
     Стол должен быть виден, иначе эффекта нет: чуть увеличиваем поля. */
  @media (min-width: 1024px) {
    :root .paper-stage {
      width: min(1440px, calc(100% - 88px));
      margin-top: 34px;
      margin-bottom: 48px;
    }
  }

  /* Подложенный второй лист: чуть меньше основного и повёрнут на пол-градуса,
     поэтому выглядывает из-под углов — как внутренний разворот газеты.
     Заодно несёт глубокую контактную тень, не трогая box-shadow самого .sheet. */
  .paper-stage::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 9px 7px 11px;
    background: color-mix(in srgb, var(--paper) 82%, var(--table-base));
    box-shadow:
      0 2px 3px var(--table-contact),
      0 18px 34px -14px var(--table-contact);
    transform: rotate(-.42deg);
    transform-origin: 50% 50%;
  }

  /* Продольный сгиб поверх листа. */
  .paper-stage::after {
    content: '';
    position: absolute;
    z-index: 6;
    inset: 0;
    pointer-events: none;
  }

  /* Продольный сгиб. Только широкая мягкая растушёвка без резкой линии:
     нужен изгиб бумаги, а не разделитель колонок. */
  @media (min-width: 960px) {
    .paper-stage::after {
      background-image:
        linear-gradient(
          90deg,
          transparent calc(50% - 170px),
          var(--fold-far) calc(50% - 54px),
          var(--fold-near) calc(50% - 8px),
          var(--fold-hi) calc(50% + 10px),
          var(--fold-tail) calc(50% + 66px),
          transparent calc(50% + 178px)
        ),
        var(--paper-grain);
      background-size: auto, 140px 140px;
    }
  }

  /* На узких экранах лист занимает почти всё — стола не видно, а лишние
     слои только грузят прокрутку. Оставляем одно зерно. */
  @media (max-width: 800px) {
    .paper-stage::before { display: none; }
  }

  /* ── Наклон листа ────────────────────────────────────────────────────
     CSS-аналог перспективы HexFloat. Стол занимает весь экран, в нём лежит
     наклонённая плоскость, а по плоскости при прокрутке едет лист.

     Лист — цельная газета во всю свою высоту, а не окно с обрезкой: ничего
     не «пропадает» на кромке, шапка просто уезжает за верх экрана вместе с
     бумагой. Прокрутка живёт на окне, высоту документу задаёт распорка
     (см. HexFloat.astro), а сдвиг листа и канцелярии — общий `--desk-shift`.

     Наклон постоянный: страница так и остаётся лежать на столе, при прокрутке
     не выпрямляется.

     Включается только там, где это уместно: мышь, широкий экран, пользователь
     не просил убрать анимации. На телефоне остаётся плоская страница со
     столом и зерном. */
  @media (min-width: 1024px) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    :root {
      --tilt-angle: 24deg;
      --tilt-persp: 2000px;
      /* Лист уже экрана — по бокам остаётся столешница под канцелярию. */
      --tilt-scale: .8;
      /* Масштаб сцены. Вёрстка у листа пиксельная, поэтому на большом экране
         он растягивался, а кегли и отступы оставались прежними: на 4K текст
         превращался в микроскопический, а канцелярия уезжала относительно
         него. Теперь сцена верстается в «дизайнерской» ширине
         (`100vw / --k` ≈ 1400–1750px на любом мониторе) и увеличивается
         целиком — картинка одна и та же, просто крупнее.
         Ступенями, а не формулой: деление длины на длину в CSS ещё не везде,
         а между ступенями ширина вёрстки всё равно остаётся в этой вилке. */
      --k: 1;
      --stage-w: calc(100vw / var(--k));
      --stage-h: calc(100vh / var(--k));
      /* Где лежит дальняя кромка газеты в начале: минус поднимает её выше,
         плюс опускает и открывает больше стола над шапкой. */
      --paper-top: -80px;
    }

    /* Полосы прокрутки нет: где мы находимся, показывает уезжающая
       канцелярия на столе. */
    html[data-paper-tilt='on'] { scrollbar-width: none; }
    html[data-paper-tilt='on']::-webkit-scrollbar { display: none; }

    /* Распорка задаёт документу высоту газеты — иначе окну нечего прокручивать:
       сам лист лежит в fixed-слое и в потоке документа не участвует. */
    html[data-paper-tilt='on'] .hexfloat-spacer {
      display: block;
      width: 1px;
      pointer-events: none;
    }

    /* Столешница переехала с `body` сюда.
       Причина в производительности. При наклоне прокручивается ОКНО, а фон
       стола прибит `background-attachment: fixed`. Такой фон браузер не может
       сдвинуть как готовую текстуру — он перерисовывает его во весь экран на
       каждом кадре прокрутки, вместе с двумя SVG-шумами (плитки 90 и 520px).
       `.hexfloat` и так `position: fixed`, поэтому тот же самый рисунок на нём
       стоит на месте сам собой: слой растеризуется один раз и дальше только
       композитится. Картинка идентичная, перерисовки на кадр нет. */
    html[data-paper-tilt='on'] .hexfloat {
      display: block;
      position: fixed;
      inset: 0;
      z-index: 0;
      /* Расстояние до камеры растёт вместе со сценой — иначе перспектива
         усилилась бы и наклон поехал. */
      perspective: calc(var(--tilt-persp) * var(--k));
      perspective-origin: 50% 44%;
      background: transparent;
    }

    /* Фактура столешницы лежит в той же наклонённой плоскости, что и лист,
       и уезжает на тот же `--desk-shift`. Слой растянут далеко за кадр, иначе
       при глубокой прокрутке из-под него показался бы чистый градиент. */
    /* На десктопе фон документа не нужен вовсе: всю площадь кадра закрывает
       фиксированный слой стола, а лишняя заливка body — ещё один слой краски
       под ним. */
    html[data-paper-tilt='on'] body { background-color: transparent; }

    /* Фактура столешницы — слой ПОД газетой в той же плоскости. Никакого
       собственного сдвига: она внутри `.hexfloat-content`, который и так
       едет на `--desk-shift`, поэтому синхрон точный по построению, а не
       подобранный. Поля с запасом — стол шире и длиннее листа. */
    html[data-paper-tilt='on'] .desk-bed {
      display: block;
      position: absolute;
      z-index: 0;
      inset: -40% -30%;
      pointer-events: none;
      /* Фактура ламината — готовый растровый тайл 96×96, а не SVG-фильтр:
         картинка декодируется один раз и дальше просто мостится, тогда как
         feTurbulence пересчитывался на каждый тайл и на каждый масштаб. */
      background-image: url('/desk-tooth.png');
      background-repeat: repeat;
      background-size: 96px 96px;
      opacity: var(--desk-tooth-alpha);
      transform: translateY(calc(var(--desk-tile, 0px) * -1));
      will-change: transform;
    }

    /* Плоскость стола: наклонена и неподвижна. */
    html[data-paper-tilt='on'] .hexfloat-plane {
      display: block;
      position: absolute;
      /* Слой размером со сцену, отцентрован полями: масштаб идёт от центра,
         поэтому после увеличения он ровно закрывает кадр. Поля — именно поля,
         а не `translate(-50%)`: процентный сдвиг считался бы от неувеличенного
         бокса и центровку бы сорвал. */
      left: 50%;
      top: 50%;
      width: var(--stage-w);
      height: var(--stage-h);
      margin-left: calc(var(--stage-w) / -2);
      margin-top: calc(var(--stage-h) / -2);
      transform: rotateX(var(--tilt-angle)) scale(calc(var(--tilt-scale) * var(--k)));
      transform-origin: 50% 50%;
    }

    /* Сама газета: во всю свою высоту, едет по плоскости и свободно выходит
       за её границы — обрезки нет, поэтому ничего не пропадает на кромке. */
    html[data-paper-tilt='on'] .hexfloat-content {
      display: block;
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      transform: translateY(calc(var(--paper-top) - var(--desk-shift, 0px)));
    }

    /* Лист и есть наклонённая плоскость: поля стола ему больше не нужны. */
    html[data-paper-tilt='on'] .paper-stage {
      width: 100%;
      margin: 0;
    }

    /* Собственный блик листа убран: он живёт в фоне `.sheet` и едет вместе
       с бумагой — «фонарик, привязанный к листу». Свет в сцене теперь один,
       от настольной лампы, и он неподвижен: бумага проезжает под ним.
       Сетка остаётся, снимается только радиальное пятно. */
    html[data-paper-tilt='on'] .sheet {
      background-image: var(--grid-layers);
      background-size: var(--grid-sizes);
    }

    /* Второй лист и сгиб рассчитаны на лежащую страницу с полями — при
       наклоне их роль играют сама плоскость и её тень. */
    html[data-paper-tilt='on'] .paper-stage::before { display: none; }
    html[data-paper-tilt='on'] .paper-stage::after { display: none; }
  }

  /* Ступени масштаба. Ширина вёрстки = 100vw / k, и она удерживается в вилке
     примерно 1400–1750px: ниже вёрстка ломается на трёх колонках, выше строка
     снова становится длиннее меры. */
  @media (min-width: 1700px) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    :root { --k: 1.2; }
  }
  @media (min-width: 2100px) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    :root { --k: 1.45; }
  }
  @media (min-width: 2500px) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    :root { --k: 1.7; }
  }
  @media (min-width: 3000px) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    :root { --k: 2.05; }
  }
  @media (min-width: 3500px) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    :root { --k: 2.4; }
  }

  /* ── HexFloat перехватил управление ──────────────────────────────────
     Наклон, швы стола и зерно рисует шейдер — CSS-слой убираем, чтобы
     зерно не накладывалось дважды. */
  html[data-hexfloat='on'] .desk-surface { display: none; }
  html[data-hexfloat='on'] .paper-stage::before,
  html[data-hexfloat='on'] .paper-stage::after { display: none; }
</style>
